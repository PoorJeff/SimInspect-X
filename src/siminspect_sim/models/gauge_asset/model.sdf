<?xml version="1.0"?>
<sdf version="1.10">
  <model name="gauge_asset">
    <static>true</static>
    <link name="gauge">
      <!-- The face centre is the include origin and its outward normal is +X. -->
      <visual name="gauge_face">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <plane>
            <normal>1 0 0</normal>
            <size>0.32 0.32</size>
          </plane>
        </geometry>
        <material>
          <pbr>
            <metal>
              <albedo_map>model://gauge_asset/materials/textures/gauge_face.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
        <cast_shadows>false</cast_shadows>
      </visual>
      <!-- Cylinder axis is rotated onto X and the housing stays behind the face. -->
      <visual name="housing">
        <pose>-0.03 0 0 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.17</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <collision name="housing_collision">
        <pose>-0.03 0 0 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.17</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
