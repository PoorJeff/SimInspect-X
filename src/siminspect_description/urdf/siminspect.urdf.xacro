<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="siminspect_amr">

  <!-- ===== MATERIALS ===== -->
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="dark_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="blue"><color rgba="0.0 0.3 0.8 1.0"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>

  <!-- ===== MACROS ===== -->
  <xacro:macro name="wheel" params="name prefix x_reflect">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.075" length="0.04"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.075" length="0.04"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <origin xyz="0 ${0.17 * x_reflect} -0.0375" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${name}"/>
      <axis xyz="0 1 0"/>
      <limit effort="10" velocity="5"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="caster" params="name x y">
    <link name="${name}">
      <visual>
        <geometry>
          <sphere radius="0.03"/>
        </geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.03"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <origin xyz="${x} ${y} -0.065" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${name}"/>
    </joint>
  </xacro:macro>

  <!-- ===== BASE LINK ===== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.30 0.15"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.30 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.15" ixy="0" ixz="0" iyy="0.20" iyz="0" izz="0.15"/>
    </inertial>
  </link>

  <!-- ===== WHEELS ===== -->
  <xacro:wheel name="left_wheel" prefix="left" x_reflect="1"/>
  <xacro:wheel name="right_wheel" prefix="right" x_reflect="-1"/>

  <!-- ===== CASTERS ===== -->
  <xacro:caster name="caster_front" x="0.15" y="0"/>
  <xacro:caster name="caster_rear" x="-0.15" y="0"/>

  <!-- ===== IMU (inside base_link) ===== -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <!-- ===== LiDAR (top) ===== -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="laser_link"/>
  </joint>

  <!-- ===== RGB CAMERA (front) ===== -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.18 0 0.12" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <!-- Camera optical frame: ROS convention x->z, y->-x -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
  </joint>

  <!-- ===== INCLUDE: Gazebo plugins ===== -->
  <xacro:include filename="siminspect.gazebo.xacro"/>

  <!-- ===== INCLUDE: ros2_control ===== -->
  <xacro:include filename="siminspect.ros2_control.xacro"/>
  <xacro:siminspect_ros2_control name="SimInspectControl" prefix="" use_sim="true"/>

</robot>
